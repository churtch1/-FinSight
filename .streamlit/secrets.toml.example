SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"
STREAMLIT_PASSWORD = "your-dashboard-password"
FX_API_URL = "https://open.er-api.com/v6/latest/USD"

# Optional: needed only if you want to upload HSBC PDF from the Streamlit app
# and let the app write parsed results back to Supabase.
# SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"

# Optional local-only settings. Streamlit Community Cloud dashboard deployment
# does not need IBKR direct access because the cloud app only reads Supabase.
# IBKR_HOST = "127.0.0.1"
# IBKR_PORT = "7497"
# IBKR_CLIENT_ID = "11"
